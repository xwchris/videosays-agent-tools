{
  "name": "videosays-agent-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Videosays CLI and agent skill for video transcripts, spoken scripts, subtitles, and batch transcription.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "help": "node packages/cli/bin/videosays.js help",
    "cli": "node packages/cli/bin/videosays.js",
    "check:skill-sync": "bash scripts/check-skill-sync.sh",
    "build:skill:portable": "node scripts/build-portable-skill.mjs",
    "build:skill:workbuddy": "node scripts/build-workbuddy-skill.mjs",
    "build:skill:china": "node scripts/build-china-skill.mjs",
    "test": "node --test packages/cli/tests/*.test.mjs && npm run check:skill-sync",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "videosays",
    "ai-agent",
    "agent",
    "transcription",
    "video-transcription",
    "video-to-text",
    "speech-to-text",
    "subtitle-generator",
    "subtitle",
    "caption",
    "caption-transcription",
    "transcript",
    "youtube-transcript",
    "tiktok-transcript",
    "instagram-transcript",
    "instagram-reels",
    "douyin-transcript",
    "xiaohongshu-transcript",
    "douyin",
    "tiktok",
    "instagram",
    "twitter-transcript",
    "twitter-video-to-text",
    "x-video-transcript",
    "x-video-to-text",
    "twitter",
    "youtube",
    "xiaohongshu",
    "bilibili",
    "kuaishou",
    "cli",
    "skill",
    "agent-skill",
    "SKILL.md",
    "视频文案提取",
    "抖音文案提取",
    "视频转文字",
    "字幕提取"
  ],
